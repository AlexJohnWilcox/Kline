# Elasticsearch
ES_URL=http://localhost:9200

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Detection
DETECTION_INTERVAL_SECONDS=30
DETECTION_COOLDOWN_MINUTES=15

# Retention
EVENT_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=365

# New-device detection. This writes its own alerts (the rule engine cannot
# express "not seen before" - see siem/detection/new_client.py). Off by
# default: on first enable it seeds its seen-set from the last
# NEW_CLIENT_SEED_DAYS days of events rather than alerting, so turning it on
# does not fire once per existing device on the network.
NEW_CLIENT_ENABLED=false
NEW_CLIENT_INTERVAL_SECONDS=300
NEW_CLIENT_SEED_DAYS=30

# Pi-hole collector
PIHOLE_ENABLED=false
PIHOLE_SSH_HOST=oracle
PIHOLE_POLL_SECONDS=30
PIHOLE_BATCH_SIZE=500
PIHOLE_BACKFILL_DAYS=30
# Path to the private half of the key the Oracle's authorized_keys pins to
# the sanctum-ftl-read forced command. Leave unset to use the ssh default.
# PIHOLE_SSH_KEY=/home/youruser/.ssh/augury_ed25519

# Extra syslog files to tail, comma separated. Empty uses the collector's
# defaults (/var/log/syslog, messages, auth.log, secure). On this host rsyslog
# writes the Gate's remote stream to /var/log/gate.log, which no default list
# includes.
SYSLOG_PATHS=

# Regexes (comma separated) whose matching syslog lines are dropped at
# ingest, never indexed. Leave this UNSET (the line commented out) to use
# the collector's own default, which drops the Oracle's dashboard collector
# re-authenticating to the Gate every 30 seconds. Set it to an explicit
# empty value to drop nothing at all -- unset and empty mean different
# things here, unlike SYSLOG_PATHS above. A malformed regex is logged and
# ignored, not fatal.
#SYSLOG_DROP_PATTERNS=

# The same, for Docker events. Matched against
# "<compose project> <container name> <action>" -- the project and name come
# from Docker's own labels, so a container cannot forge them through the
# command it runs. Anchor your patterns (^...$): one that keys only on
# command text lets any container opt itself out of logging by embedding the
# magic substring. A malformed regex is logged and ignored, not fatal.
# Unset uses the collector's default, which drops Kline's own Elasticsearch
# healthcheck: measured on the live deployment, that healthcheck was 100% of
# the Docker events collected in 24 hours and 43% of everything collected in
# 48 -- the instrument watching its own heartbeat. Set an explicit empty
# value to ingest it after all. Dropping the healthcheck does NOT drop every
# exec: a real `docker exec` into the same container is still recorded,
# including its exec_die.
#DOCKER_DROP_PATTERNS=

# Device names (resolved for display only; never written onto events)
DEVICE_NAMES_ENABLED=false
DEVICE_ROSTER_URL=https://dash.lan/data.json
# DEVICE_ROSTER_CA is effectively REQUIRED whenever the roster is served with
# a private CA - which dash.lan is, since Caddy signs it with its own root.
# "My browser trusts it" and "curl works" do NOT mean Kline will: httpx
# verifies against certifi's CA bundle, not the system trust store. Left
# unset here, every refresh logs device_roster_fetch_failed, forever, and the
# panel shows raw addresses with resolved:false.
# Fetch the root once (the file below does not exist until you do):
#   mkdir -p ~/.config/kline
#   curl -s https://dash.lan/caddy-root.crt -o ~/.config/kline/caddy-root.crt
# (add -k if curl itself does not trust dash.lan yet, and check the
# fingerprint out of band before you rely on it).
# Leave this unset only if the roster URL is served by a publicly trusted
# certificate, i.e. one already in certifi's bundle.
# DEVICE_ROSTER_CA=/home/nyx/.config/kline/caddy-root.crt
DEVICE_ROSTER_REFRESH_SECONDS=300

# Security — CHANGE BOTH BEFORE THIS APP LISTENS ANYWHERE BUT LOCALHOST.
# APP_HOST above defaults to 0.0.0.0, so "beyond localhost" is the default,
# not the exception.
#
# SESSION_SECRET signs the kline_session cookie. Unset, it is a fresh random
# value per process, so every restart logs everyone out. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace-me-with-a-random-32-byte-value

# Seeded on first boot only, and only if the username does not already
# exist. There is no built-in default: leave either unset and no admin is
# seeded, and the app logs admin_seed_skipped at startup.
ADMIN_USERNAME=changeme
ADMIN_PASSWORD=replace-me-before-first-boot
